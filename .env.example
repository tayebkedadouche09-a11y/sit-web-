# =============================================================================
# NUMI v5.0.1-HARDENED — Environment variables
# Copy to .env — never commit .env
# =============================================================================

# --- REQUIRED to boot storefront + API ---
DATABASE_URL=
PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=
NODE_ENV=development
PORT=3000

# --- REQUIRED for real customer login / owner admin ---
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# --- OPTIONAL payments (at least one for live sales) ---
CHARGILY_SECRET_KEY=
CHARGILY_API_URL=https://pay.chargily.net/api/v2
FEATURE_CHARGILY=true

STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_URL=https://api-m.paypal.com
PAYPAL_WEBHOOK_ID=

# --- OPTIONAL native auto-delivery (GitHub private copy + Vercel) ---
FEATURE_NATIVE_PROVISIONING=true
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_API_URL=https://api.github.com
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_API_URL=https://api.vercel.com

# --- OPTIONAL external provision worker ---
PROVISIONING_API_URL=
PROVISIONING_API_KEY=
AUTOMATION_WORKER_SECRET=

# --- OPTIONAL isolated customer DB (default none = not required for READY) ---
# Supported create path: neon (when keys set). Other values → NOT_CONFIGURED.
CUSTOMER_DB_PROVIDER=none
NEON_API_KEY=
NEON_ORG_ID=
NEON_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORG_ID=

# --- OPTIONAL encryption / backup ---
SECRETS_ENCRYPTION_KEY=
BACKUP_WEBHOOK_URL=
STORAGE_PROVIDER=none
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- OPTIONAL email (default none = NOT_CONFIGURED, no fake send) ---
EMAIL_PROVIDER=none
EMAIL_FROM=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- OPTIONAL monitoring / UI ---
MONITORING_WEBHOOK_URL=
SENTRY_DSN=
FEATURE_AI_FAQ=false
VITE_WHATSAPP_NUMBER=
